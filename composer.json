{
    "name": "nicmaxcarter/slim-plates",
    "description": "Slim + Plates bridge: view adapter, asset helpers, fixi responses, and middleware guards",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "league/plates": "^3.6",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "slim/flash": "^0.4"
    },
    "suggest": {
        "slim/slim": "Route parser integration for url_for(); provides psr/http-server-handler for AbstractViewContextMiddleware",
        "slim/flash": "Flash-to-toast redirect helpers"
    },
    "autoload": {
        "psr-4": {
            "NicmaxCarter\\SlimPlates\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/composer.lock",
            "/.phpunit.cache",
            "/.phpstan.cache"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "check": [
            "@composer validate --strict",
            "@test",
            "@stan"
        ]
    }
}
